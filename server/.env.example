# Copy this file to .env and fill in your own values. Never commit .env.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
PORT=3000

# Optional extras. Leave any of these empty to turn that feature off.
# Role pinged on every post, and given to new members with a welcome message
# (needs Server Members Intent and the Manage Roles permission).
DISCORD_ROLE_ID=
# Polls and the monthly check-in go here instead of DISCORD_CHANNEL_ID.
DISCORD_SUGGESTIONS_CHANNEL_ID=
# Server ID: registers the /ring backup command in that server.
DISCORD_GUILD_ID=
